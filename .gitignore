# Environment
.env
.env.local
.env.*.local

# Local dev-script state (see scripts/full-restart.sh) — a phone
# number cached per-machine, not project config.
.twilio-test-number

# Python
# Scoped to backend/ (not left bare) — an unscoped `lib/`, `build/`,
# etc. would also match same-named source directories elsewhere in
# this repo (e.g. frontend/src/lib/), silently excluding real frontend
# source files from every `git add`. Found the hard way: this phase's
# frontend/src/lib/format.ts never showed up in `git status` at all
# until this was fixed.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/env/
backend/venv/
backend/ENV/
backend/build/
backend/develop-eggs/
dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

