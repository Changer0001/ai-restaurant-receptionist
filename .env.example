# ============================================================================
# AI RESTAURANT RECEPTIONIST - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ============================================================================
# APPLICATION
# ============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# SECURITY
# ============================================================================
# Generate: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string (must use the asyncpg driver scheme — the
# backend uses SQLAlchemy's async engine, which requires an async DBAPI)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://restaurantai:restaurantai@postgres:5432/restaurantai
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# CACHE & MESSAGE QUEUE
# ============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_DEFAULT_TTL=3600

# ============================================================================
# VECTOR DATABASE (RAG)
# ============================================================================
VECTOR_DB_URL=http://chromadb:8000
# Or use Qdrant: http://qdrant:6333
VECTOR_DB_PROVIDER=chromadb
VECTOR_DB_COLLECTION_PREFIX=restaurant_

# ============================================================================
# LANGUAGE MODEL (LLM)
# ============================================================================
# "ollama" (fully local/private — needs a GPU for the conversation to
# respond quickly enough on a real phone call) or "groq" (hosted, free
# tier available, fast enough on CPU-only hardware). Lets the same
# codebase be deployed either way per client.
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_REQUEST_TIMEOUT=60

# Alternative models (uncomment to use)
# OLLAMA_MODEL=llama2:latest
# OLLAMA_MODEL=mistral:latest

# Only read when LLM_PROVIDER=groq. Get a free key at
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT=30
# Faster/cheaper alternative if 120b's latency or free-tier limits are an issue:
# GROQ_MODEL=openai/gpt-oss-20b

# Model for the two classification calls each turn (is the caller upset?
# what do they want?). Both answer with one word from a fixed list, which
# doesn't need the large model — and they sit in the caller's silence,
# two of the three LLM round trips per turn. Set it equal to GROQ_MODEL
# if classification accuracy ever looks worse than the latency is worth.
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b
# Groq's lineup changes — if you hit a 404 from Groq, check
# https://console.groq.com/docs/deprecations for a current model ID.

# Separate, smaller model used only for RAG embeddings (not chat).
# Always served by Ollama regardless of LLM_PROVIDER — Groq's API
# doesn't serve embeddings.
# Pull it once with: docker compose exec ollama ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ============================================================================
# SPEECH-TO-TEXT (STT)
# ============================================================================
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
# Device options: cuda, cpu
# large-v3 requires ~6GB VRAM
#
# ON A CPU-ONLY MACHINE, use `small` (or `small.en`), not `base`.
# Telephone audio is 8kHz — the hardest case Whisper faces — and `base`
# mangles exactly the words a restaurant caller says: real calls produced
# "hollow options" for "halal options" and "chicken show, Emma" for
# "chicken shawarma". Accented speech suffers most. `small` with int8
# below is both more accurate AND faster than `base` at float32:
#   WHISPER_MODEL=small
#   WHISPER_DEVICE=cpu

# Quantization. Empty picks by device (float16 on CUDA, int8 on CPU).
# int8 on CPU is ~3-4x faster than float32 for negligible accuracy loss,
# which is what makes a bigger, more accurate model affordable there.
WHISPER_COMPUTE_TYPE=

# Decode beam width. 1 (greedy) is the default here and is much faster.
# Transcription cost barely moves with how long the caller spoke — the
# encoder runs over a fixed 30-second window either way — so the decode
# is the part worth shrinking. Raise toward 5 if transcripts get worse.
WHISPER_BEAM_SIZE=1

# CPU threads for inference; 0 lets CTranslate2 choose.
WHISPER_CPU_THREADS=0

# Vocabulary hint for Whisper — the single highest-value STT setting for
# a menu full of words that aren't everyday English. Whisper biases
# toward spellings it has just seen, so listing this restaurant's dish
# names measurably improves them at no runtime cost, and helps most with
# accented speech. Replace the defaults with YOUR restaurant's menu
# vocabulary. See STT_INITIAL_PROMPT in backend/app/core/config.py.
# STT_INITIAL_PROMPT="Thanks for calling. We serve ..."

# ============================================================================
# TEXT-TO-SPEECH (TTS)
# ============================================================================
TTS_PROVIDER=kokoro
# Options: kokoro, piper
KOKORO_DEVICE=cuda
# Device options: cuda, cpu
# Kokoro's own single-letter codes (not ISO 639-1): a=American English,
# b=British English, j=Japanese, z=Chinese, etc.
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
# Speaking rate. Synthesis time scales with how much audio is produced,
# so this shortens both the wait and the playback. Past ~1.25 it starts
# to sound hurried, which costs more in warmth than it saves in seconds.
KOKORO_SPEED=1.15

# Fallback TTS provider (CPU-friendly). Requires a downloaded Piper
# voice model — see https://github.com/rhasspy/piper/blob/master/VOICES.md
PIPER_VOICE_MODEL_PATH=/models/piper/en_US-lessac-medium.onnx

# ============================================================================
# TWILIO TELEPHONY
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WEBHOOK_SECRET=your_webhook_secret
TWILIO_DEFAULT_TRANSFER_TIMEOUT=30

# ============================================================================
# SMTP / EMAIL NOTIFICATIONS
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourrestaurant.com
SMTP_FROM_NAME=AI Receptionist

# ============================================================================
# SMS / NOTIFICATION SETTINGS
# ============================================================================
SMS_PROVIDER=twilio
# SMS notifications are sent via Twilio (same account as voice)

# Notification worker (app/worker.py — see docker-compose.yml's `worker`
# service): how often it polls for due, unsent notifications, and its
# retry policy for ones that fail to send.
NOTIFICATION_POLL_INTERVAL_SECONDS=15
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_BASE_SECONDS=60
NOTIFICATION_BACKOFF_MAX_SECONDS=3600

# ============================================================================
# PUBLIC URL & WEBHOOKS
# ============================================================================
# This is the public URL where Twilio can reach your webhook
# Example: https://restaurant.example.com
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_DOMAIN=localhost
WEBHOOK_BASE_PATH=/webhooks

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_V1_PREFIX=/api
API_TITLE=AI Restaurant Receptionist
API_DESCRIPTION=Voice AI for restaurant phone management
API_VERSION=0.1.0

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS_PER_MINUTE=100
RATE_LIMIT_WEBHOOK_PER_HOUR=10000

# ============================================================================
# AI CONVERSATION SETTINGS
# ============================================================================
# Maximum tokens in context
MAX_CONTEXT_TOKENS=2048
# Temperature for LLM sampling (0.0-1.0)
CONVERSATION_TEMPERATURE=0.7
# System prompt file (relative to backend/app/prompts/)
SYSTEM_PROMPT_FILE=receptionist_system.txt

# ============================================================================
# RAG / KNOWLEDGE BASE
# ============================================================================
# Chunk size for document splitting
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# Number of results to retrieve for context
RAG_RETRIEVAL_TOP_K=5
# Cosine-similarity threshold a retrieved chunk must clear to be used as
# grounding for an answer (0.0-1.0). Calibrated against real call
# transcripts — see the comment on RAG_RELEVANCE_THRESHOLD in
# backend/app/core/config.py before changing it. Short spoken questions
# score lower against short reference documents than you'd expect: a
# correct, unambiguous match measured 0.485, so a "sensible-looking" 0.6
# silently rejected right answers.
RAG_RELEVANCE_THRESHOLD=0.45

# ============================================================================
# CALL RECORDING & STORAGE
# ============================================================================
CALL_RECORDING_ENABLED=true
CALL_RECORDING_PROVIDER=local
# Options: local, s3, gcs (for future cloud storage)
LOCAL_STORAGE_PATH=/data/recordings

# Retention policy (days)
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
STRUCTURED_LOGGING=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_CALL_RECORDING=true
FEATURE_CALL_TRANSFER=true
FEATURE_RESERVATION_COLLECTION=true
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_RAG=true
FEATURE_AI_CLASSIFICATION=true

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================
# For local testing without real Twilio
MOCK_TWILIO=false

# Database reset on startup (DANGEROUS - development only)
DATABASE_RESET_ON_STARTUP=false

# Seed test data
DATABASE_SEED_TEST_DATA=false
