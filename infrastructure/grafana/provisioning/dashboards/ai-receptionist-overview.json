    {
      "id": 2,
      "type": "stat",
      "title": "Calls Finalized (1h)",
      "description": "sum(increase(calls_total[1h]))",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(calls_total[1h]))",
          "datasource": { "type": "prometheus", "uid": "prometheus_ds" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" },
        "overrides": []
      },
      "options": {
